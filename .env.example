# Строка подключения к PostgreSQL: пользователь:пароль@хост:порт/база
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/risk_orchestrator
# Ускорение симуляции: 1 = реальное время, 5 = в пять раз быстрее
TIME_SCALE=1
# Через сколько секунд ожидания запуск получает +1 к приоритету
AGING_SEC=10
# Вероятность имитации сбоя расчёта (0.1 = 10%)
FAIL_PROB=0.1